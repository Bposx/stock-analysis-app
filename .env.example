# ===== API Keys (ຕ້ອງການສໍາລັບ Foreign Stocks) =====
# Yahoo Finance ຟຣີ - ບໍ່ຕ້ອງການ API key
# Finnhub (Optional - ສໍາລັບ WebSocket real-time)
FINNHUB_API_KEY=your_finnhub_key_here

# Alpha Vantage (Optional - ສໍາລັບ fundamental data)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Polygon.io (Optional - professional real-time)
POLYGON_API_KEY=your_polygon_key_here

# ===== LSX Scraper Settings =====
LSX_BASE_URL=https://www.lsx.com.la
LSX_SCRAPE_INTERVAL_MINUTES=15
LSX_HEADLESS=true

# ===== Database =====
DATABASE_URL=sqlite+aiosqlite:///./stock_data.db

# ===== App Settings =====
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
